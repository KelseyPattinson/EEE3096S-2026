 185:Core/Src/main.c **** void mode1_update(void)
 186:Core/Src/main.c **** {
 187:Core/Src/main.c **** 	// at some point should current_LED be reset to zero?
 188:Core/Src/main.c **** 	/* TODO: Implement the standard running light sequence (Task 3 logic) */
 189:Core/Src/main.c **** 	// 1. Turn off all LEDs
 190:Core/Src/main.c **** 	clear_all_leds();
 191:Core/Src/main.c **** 
 192:Core/Src/main.c **** 	// 2. Turn on the current LED
 193:Core/Src/main.c **** 	turn_on_led(current_led);
 194:Core/Src/main.c **** 	// 3. Update the current_led index based on direction
 195:Core/Src/main.c **** 
 196:Core/Src/main.c **** 	// 4. Handle direction reversal at the edges (without duplicating states)
 197:Core/Src/main.c **** 	if (current_led==7){
 198:Core/Src/main.c **** 	  	direction = -1;
 199:Core/Src/main.c **** 	   }
 200:Core/Src/main.c **** 	else if (current_led==0){
 201:Core/Src/main.c **** 	   	direction = 1;
 202:Core/Src/main.c **** 	   }
 203:Core/Src/main.c **** 	current_led += direction; //move to the next LED
 204:Core/Src/main.c **** }
