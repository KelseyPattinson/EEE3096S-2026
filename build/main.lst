 205:Core/Src/main.c **** 
 206:Core/Src/main.c **** void mode2_update(void)
 207:Core/Src/main.c **** {
 208:Core/Src/main.c ****     /* TODO: Implement the inverse running light sequence. All LEDs on except one. */
 209:Core/Src/main.c **** 	// 1. Turn on all LEDs
 210:Core/Src/main.c **** 	for (uint8_t i = 0; i < 8; i++) {
 211:Core/Src/main.c **** 		turn_on_led(i);
 212:Core/Src/main.c **** 	   }
 213:Core/Src/main.c **** 	// 2. Turn off the current LED
 214:Core/Src/main.c **** 	turn_off_led(current_led);
 215:Core/Src/main.c **** 
 216:Core/Src/main.c **** 	// 3. Update the current_led index based on direction
 217:Core/Src/main.c **** 	current_led+=direction; //direction = 1, adding to move forward
 218:Core/Src/main.c **** 
 219:Core/Src/main.c **** 	// 4. Handle direction reversal at the edges (without duplicating states)
 220:Core/Src/main.c **** 	if (current_led==7){
 221:Core/Src/main.c **** 	 	direction = -1;
 222:Core/Src/main.c **** 	  }
 223:Core/Src/main.c **** 	else if (current_led==0){
 224:Core/Src/main.c **** 	   	direction = 1;
 225:Core/Src/main.c **** 	  }
 226:Core/Src/main.c **** 	current_led += direction; //move to the next LED
 227:Core/Src/main.c **** }
