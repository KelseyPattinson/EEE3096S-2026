 113:Core/Src/main.c **** void handle_buttons(void)
 114:Core/Src/main.c **** {
 115:Core/Src/main.c ****     uint32_t now = HAL_GetTick();
 116:Core/Src/main.c **** 
 117:Core/Src/main.c ****     /* TODO: Read the state of all four buttons (PA0 to PA3) */
 118:Core/Src/main.c **** 
 119:Core/Src/main.c ****     /* TODO: Implement debounce logic for PA0. Toggle the timer speed between 500ms and 1000ms. */
 120:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0)== GPIO_PIN_RESET ){
 121:Core/Src/main.c ****     	uint32_t elapsed_time = now - last_button_time[0];
 122:Core/Src/main.c **** 
 123:Core/Src/main.c ****     	// If a valid debounced press occurs:
 124:Core/Src/main.c ****     	if (elapsed_time>= DEBOUNCE_MS){
 125:Core/Src/main.c ****     	    // 1. Update last_button_press_time.
 126:Core/Src/main.c ****     		last_button_time[0]=now;
 127:Core/Src/main.c ****     	    // 2. Toggle speed_state between 0 and 1.
 128:Core/Src/main.c ****     	    if (speed_state==0){
 129:Core/Src/main.c ****     	    	speed_state=1;
 130:Core/Src/main.c ****     	    }
 131:Core/Src/main.c ****     	    else if (speed_state==1){
 132:Core/Src/main.c ****     	    	speed_state=0;
 133:Core/Src/main.c ****     	    }
 134:Core/Src/main.c ****     	    // 3. Call change_timer_period() with 500 or 1000.
 135:Core/Src/main.c ****     	    if (speed_state==0){
 136:Core/Src/main.c ****     	    	change_timer_period(1000);
 137:Core/Src/main.c ****     	    }
 138:Core/Src/main.c ****     	    else if (speed_state==1){
 139:Core/Src/main.c ****     	    	change_timer_period(500);
 140:Core/Src/main.c ****     	    }}
 141:Core/Src/main.c **** 
 142:Core/Src/main.c ****     }
 143:Core/Src/main.c ****     else if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_1)==GPIO_PIN_RESET){
 144:Core/Src/main.c ****     	/* TODO: Implement debounce logic for PA1. Call set_mode(MODE_1). */
 145:Core/Src/main.c ****     	if ((now - last_button_time[1]) >= DEBOUNCE_MS)
 146:Core/Src/main.c ****     	    {
 147:Core/Src/main.c ****     	        last_button_time[1] = now;
ARM GAS  C:\Users\kelse\AppData\Local\Temp\ccx0RylH.s 			page 4


 148:Core/Src/main.c ****     	        set_mode(MODE_1);
 149:Core/Src/main.c ****     	    }
 150:Core/Src/main.c ****     }
 151:Core/Src/main.c ****     else if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_2)==GPIO_PIN_RESET){
 152:Core/Src/main.c ****     	/* TODO: Implement debounce logic for PA2. Call set_mode(MODE_2). */
 153:Core/Src/main.c ****     	if ((now - last_button_time[2]) >= DEBOUNCE_MS)
 154:Core/Src/main.c ****     	    {
 155:Core/Src/main.c ****     	        last_button_time[2] = now;
 156:Core/Src/main.c ****     	        set_mode(MODE_2);
 157:Core/Src/main.c ****     	    }
 158:Core/Src/main.c ****     }
 159:Core/Src/main.c ****     else if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_3)==GPIO_PIN_RESET){
 160:Core/Src/main.c ****     	/* TODO: Implement debounce logic for PA3. Call set_mode(MODE_3). */
 161:Core/Src/main.c ****     	if ((now - last_button_time[3]) >= DEBOUNCE_MS)
